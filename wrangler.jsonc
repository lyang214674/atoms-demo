{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "atoms-demo",
	"main": "worker/index.ts",
	"compatibility_date": "2025-06-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"assets": {
		"directory": "./dist",
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*",
			"/raw/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "atoms-demo",
			"database_id": "11cae431-a955-487f-9046-39c824737683",
			"migrations_dir": "migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vars": {
		// Default provider: Cloudflare Workers AI — no API key, no region restrictions,
		// free daily allowance. Switch to "openai" to use any OpenAI-compatible endpoint
		// (then set LLM_BASE_URL + secret LLM_API_KEY, e.g. Gemini/DeepSeek/OpenAI).
		"LLM_PROVIDER": "workers-ai",
		// Must be available on the Workers Free plan (no `require_workers_paid`).
		"LLM_MODEL": "@cf/google/gemma-4-26b-a4b-it",
		// Optional cheaper model for Planner / Reviewer; falls back to LLM_MODEL.
		// "LLM_MODEL_FAST": "@cf/qwen/qwen2.5-coder-32b-instruct",
		// Per-user generation cap per UTC day, to bound API spend during review.
		"DAILY_GEN_LIMIT": "10",
		// All users combined per UTC day. Workers AI free tier = 10,000 neurons/day,
		// one full generation with Gemma 4 costs roughly 300 neurons.
		"GLOBAL_DAILY_GEN_LIMIT": "30"
	},
	"observability": {
		"enabled": true
	}
	// Secrets (set with `wrangler secret put`), only for LLM_PROVIDER=openai:
	//   LLM_API_KEY
}
