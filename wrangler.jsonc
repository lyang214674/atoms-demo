{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atoms-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/raw/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atoms-demo",
      "database_id": "REPLACE_AFTER_wrangler_d1_create",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // OpenAI-compatible endpoint. Works for OpenAI, DeepSeek, Gemini (openai/ path), Groq, etc.
    "LLM_BASE_URL": "https://api.openai.com/v1",
    "LLM_MODEL": "gpt-4o-mini",
    // Per-user generation cap per UTC day, to bound API spend during review.
    "DAILY_GEN_LIMIT": "30"
  },
  "observability": { "enabled": true }
  // Secrets (set with `wrangler secret put`):
  //   LLM_API_KEY
}
