# Copy to .dev.vars for local `wrangler dev`. Never commit real keys.
LLM_API_KEY=your-key
# Optional overrides (defaults live in wrangler.jsonc vars):
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.5-flash
# LLM_MODEL_FAST=gemini-3.5-flash-lite
# DeepSeek example: LLM_BASE_URL=https://api.deepseek.com/v1  LLM_MODEL=deepseek-chat
